/*
 * A95X F3 Air (S905X3): mainline U-Boot chainloaded by the stock vendor
 * U-Boot (aml_autoscript -> go 0x1000000).
 *
 * Boots unmodified Android images from the first USB device (then SD) that
 * holds uEnv.txt, boot.img or recovery.img, else from the eMMC partitions
 * (see a95x_load_emmc):
 *   boot.img / recovery.img  Android boot image v0-v2 (kernel, ramdisk,
 *                            cmdline; v2 also the DTB)
 *   dtb.img                  DTB (plain or gzip); else the DTB of the image
 *   dtbo.img                 Android DTBO table, entry a95x_dtbo_idx applied
 *   uEnv.txt                 optional: name=value overrides (a95x_image,
 *                            a95x_extra_args, ...); if it sets uenvcmd, that
 *                            runs instead (custom boot, devtype/devnum set)
 *   a95x/<name>.txt          fixups, for each name in a95x_fixups: imported
 *                            (env import -t) and "run fix_<name>" right before
 *                            bootm; the DTB is at fdt_addr_r, the image name
 *                            in a95x_img. Board tweaks live there, not here.
 *
 * The environment lives only in RAM (no ENV_IS_IN_*), nothing is written
 * to the eMMC.
 *
 * Installed copy: the rsv partition at +1 MiB; the stock bootcmd loads it to
 * 0x1000000 and jumps there when no USB stick boots.
 */

/* boot.img or recovery.img; the other one is the fallback */
a95x_image=boot.img
a95x_dtb=dtb.img
a95x_dtbo=dtbo.img
a95x_dtbo_idx=0
a95x_fixdir=a95x
a95x_fixups=
a95x_extra_args=androidboot.selinux=permissive vfd_show_boot=1

/*
 * eMMC partitions without a USB/SD image: a95x_part (boot or recovery) and
 * dtbo. Mainline U-Boot cannot read the Amlogic partition table (MPT), so
 * the LBAs are fixed; they are the same in the stock A95X table. The eMMC is
 * the mmc device with "MPT" at a95x_mpt_lba.
 */
a95x_part=boot
a95x_mpt_lba=0x12000
a95x_boot_lba=0x2ae000
a95x_boot_blks=0x8000
a95x_recovery_lba=0x27a000
a95x_recovery_blks=0xc000
a95x_dtbo_lba=0x292000
a95x_dtbo_blks=0x4000
a95x_misc_lba=0x28a000

a95x_txt_addr=0x1b000000
/*
 * 2 MiB aligned: arm64 Image with text_offset 0 (5.15) is moved to the 2 MiB
 * boundary below the load address; 0x08080000 would put it over the DTB.
 */
a95x_kernel_addr=0x08200000
a95x_ovl_addr=0x1c000000
a95x_tmp_addr=0x1d000000
a95x_dtbo_addr=0x1e000000
a95x_img_addr=0x20000000

/*
 * Vendor kvim3l storeargs/initargs (5.15), minus logo=...,loaded: mainline
 * does not leave a vendor OSD logo, so vout=...,disable makes the kernel set
 * the HDMI mode itself. bootm appends the image header cmdline after these;
 * init keeps the first value of each androidboot.* property.
 *
 * No kernel console on the UART (console=null, as on the other Amlogic boards
 * here): printing to it at 115200 baud blocks for as long as the kernel
 * logs, which stalled audio, display and video decoding for about a second
 * every time a decoder started. dmesg and pstore keep the log.
 */
a95x_args=init=/init console=null printk.devkmsg=on
	ramoops.pstore_en=1 ramoops.record_size=0x8000 ramoops.console_size=0x4000
	reboot_mode_android=normal
	outputmode=1080p60hz vout=1080p60hz,disable hdmimode=1080p60hz
	nativeui=disable frac_rate_policy=1 hdmi_read_edid=1 cvbsmode=576cvbs
	osd_reverse=0 video_reverse=0 irq_check_en=0 jtag=disable
	androidboot.hardware=amlogic androidboot.verifiedbootstate=orange
	androidboot.selinux=enforcing androidboot.firstboot=1
	androidboot.bootloader=U-Boot-mainline
	androidboot.serialno=a95xf3air0001
	androidboot.init_fatal_reboot_target=recovery

/* Sets devtype/devnum to the first device holding one of the boot files. */
a95x_find=
	setenv devtype;
	usb start;
	for d in 0 1 2 3; do
		for f in uEnv.txt boot.img recovery.img; do
			if test -z "${devtype}" && test -e usb ${d} ${f}; then
				setenv devtype usb; setenv devnum ${d};
			fi;
		done;
	done;
	/* No mmc aliases: SDIO, SD and eMMC are mmc 0-2 in DT order. */
	for d in 0 1 2; do
		for f in uEnv.txt boot.img recovery.img; do
			if test -z "${devtype}" && test -e mmc ${d} ${f}; then
				setenv devtype mmc; setenv devnum ${d};
			fi;
		done;
	done

/* DTB to fdt_addr_r: dtb.img (plain or gzip), else the one in the image. */
a95x_load_fdt=
	setenv a95x_fdt_ok;
	if test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${a95x_tmp_addr} ${a95x_dtb}; then
		setexpr.w a95x_magic *${a95x_tmp_addr};
		if test "${a95x_magic}" = "8b1f"; then
			unzip ${a95x_tmp_addr} ${fdt_addr_r} && setenv a95x_fdt_ok 1;
		else
			cp.b ${a95x_tmp_addr} ${fdt_addr_r} ${filesize} &&
			setenv a95x_fdt_ok 1;
		fi;
		if test -n "${a95x_fdt_ok}" && fdt addr ${fdt_addr_r}; then
			echo "a95x: DTB from ${a95x_dtb}";
		else
			echo "a95x: ${a95x_dtb} is not a DTB (Amlogic multi-DTB?)";
			setenv a95x_fdt_ok;
		fi;
	fi;
	if test -z "${a95x_fdt_ok}" &&
	   abootimg get dtb --index=0 a95x_src a95x_size; then
		cp.b ${a95x_src} ${fdt_addr_r} ${a95x_size} &&
		fdt addr ${fdt_addr_r} && setenv a95x_fdt_ok 1 &&
		echo "a95x: DTB from ${a95x_img}";
	fi;
	if test -n "${a95x_fdt_ok}"; then
		fdt addr ${fdt_addr_r} && fdt resize 16384;
	fi

/* DTBO table at a95x_dtbo_addr: entry a95x_dtbo_idx onto the DTB. */
a95x_apply_dtbo=
	if adtimg addr ${a95x_dtbo_addr} &&
	   adtimg get dt --index=${a95x_dtbo_idx} a95x_src a95x_size &&
	   cp.b ${a95x_src} ${a95x_ovl_addr} ${a95x_size} &&
	   fdt addr ${fdt_addr_r} && fdt apply ${a95x_ovl_addr}; then
		echo "a95x: applied ${a95x_dtbo_src} entry ${a95x_dtbo_idx}";
	else
		echo "a95x: ${a95x_dtbo_src} not applied, reloading the DTB";
		run a95x_load_fdt;
	fi

/* dtbo.img from the device, else the eMMC dtbo partition when booting it. */
a95x_load_dtbo=
	setenv a95x_dtbo_src;
	if test -n "${a95x_dtbo}" && test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${a95x_dtbo_addr} ${a95x_dtbo}; then
		setenv a95x_dtbo_src ${a95x_dtbo};
	elif test -n "${a95x_dtbo}" && test "${a95x_img}" = "${a95x_part}" &&
	     mmc dev ${a95x_emmc} &&
	     mmc read ${a95x_dtbo_addr} ${a95x_dtbo_lba} ${a95x_dtbo_blks}; then
		setenv a95x_dtbo_src "eMMC dtbo";
	fi;
	if test -n "${a95x_dtbo_src}"; then
		run a95x_apply_dtbo;
	fi

/* Imports and runs each fixup file; a missing file is skipped. */
a95x_run_fixups=
	for f in ${a95x_fixups}; do
		if load ${devtype} ${devnum} ${a95x_txt_addr} ${a95x_fixdir}/${f}.txt; then
			echo "a95x: fixup ${a95x_fixdir}/${f}.txt";
			env import -t -r ${a95x_txt_addr} ${filesize};
			run fix_${f};
		else
			echo "a95x: no ${a95x_fixdir}/${f}.txt, skipped";
		fi;
	done

/* Sets a95x_emmc to the mmc device with the Amlogic MPT. */
a95x_find_emmc=
	setenv a95x_emmc;
	for d in 0 1 2; do
		if test -z "${a95x_emmc}" && mmc dev ${d} &&
		   mmc read ${a95x_tmp_addr} ${a95x_mpt_lba} 1; then
			setexpr.l a95x_magic *${a95x_tmp_addr};
			if test "${a95x_magic}" = "54504d"; then
				setenv a95x_emmc ${d};
			fi;
		fi;
	done;
	if test -n "${a95x_emmc}"; then
		echo "a95x: eMMC is mmc ${a95x_emmc}";
	fi

/* Image a95x_part (boot or recovery) from the eMMC to a95x_img_addr. */
a95x_load_emmc=
	if test "${a95x_part}" = recovery; then
		setenv a95x_lba ${a95x_recovery_lba};
		setenv a95x_blks ${a95x_recovery_blks};
	else
		setenv a95x_part boot;
		setenv a95x_lba ${a95x_boot_lba};
		setenv a95x_blks ${a95x_boot_blks};
	fi;
	if test -n "${a95x_emmc}" && mmc dev ${a95x_emmc} &&
	   mmc read ${a95x_img_addr} ${a95x_lba} ${a95x_blks}; then
		setenv a95x_img ${a95x_part};
		echo "a95x: ${a95x_part} from eMMC (mmc ${a95x_emmc})";
	fi

/*
 * Recovery when Android asked for it, so it works without a USB/SD image:
 * reboot reason "recovery" (kernel "reboot recovery"/"factory_reset"; the
 * stock U-Boot only reads it) or "boot-recovery" in the misc BCB. uEnv.txt
 * is imported later and can still override a95x_image/a95x_part.
 */
a95x_want_recovery=
	setenv a95x_reason;
	sm reboot_reason a95x_reason;
	setenv a95x_w0; setenv a95x_w1;
	if test -n "${a95x_emmc}" && mmc dev ${a95x_emmc} &&
	   mmc read ${a95x_tmp_addr} ${a95x_misc_lba} 1; then
		setexpr.l a95x_w0 *${a95x_tmp_addr};
		setexpr a95x_w1 ${a95x_tmp_addr} + 4;
		setexpr.l a95x_w1 *${a95x_w1};
	fi;
	if test "${a95x_reason}" = recovery ||
	   test "${a95x_w0}${a95x_w1}" = "746f6f626365722d"; then
		echo "a95x: recovery requested (reason ${a95x_reason})";
		setenv a95x_part recovery;
		setenv a95x_image recovery.img;
	fi

a95x_android=
	setenv kernel_addr_r ${a95x_kernel_addr};
	setenv a95x_img;
	if test -n "${devtype}"; then
		for f in ${a95x_image} boot.img recovery.img; do
			if test -z "${a95x_img}" &&
			   load ${devtype} ${devnum} ${a95x_img_addr} ${f}; then
				setenv a95x_img ${f};
				echo "a95x: ${f} from ${devtype} ${devnum}";
			fi;
		done;
	fi;
	if test -z "${a95x_img}"; then
		run a95x_load_emmc;
	fi;
	if test -z "${a95x_img}"; then
		echo "a95x: no boot.img/recovery.img on USB/SD and no eMMC";
	elif abootimg addr ${a95x_img_addr}; then
		run a95x_load_fdt;
		if test -z "${a95x_fdt_ok}"; then
			echo "a95x: no DTB (dtb.img or in ${a95x_img})";
		else
			run a95x_load_dtbo;
			run a95x_run_fixups;
			setenv bootargs "${a95x_args} ${a95x_extra_args}";
			echo "a95x: bootargs: ${bootargs}";
			bootm ${a95x_img_addr} ${a95x_img_addr} ${fdt_addr_r};
		fi;
	else
		echo "a95x: ${a95x_img} is not an Android boot image";
	fi

a95x_boot=
	run a95x_find;
	run a95x_find_emmc;
	run a95x_want_recovery;
	if test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${a95x_txt_addr} uEnv.txt; then
		echo "a95x: importing uEnv.txt from ${devtype} ${devnum}";
		env import -t -r ${a95x_txt_addr} ${filesize};
	fi;
	if test -n "${uenvcmd}"; then
		echo "a95x: running uenvcmd";
		run uenvcmd;
		echo "a95x: uenvcmd failed, booting the Android image";
	fi;
	run a95x_android
