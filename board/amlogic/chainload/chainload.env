/*
 * S905X3 (SM1) TV boxes: mainline U-Boot chainloaded by the stock vendor
 * U-Boot (aml_autoscript -> go 0x1000000). Written for the A95X F3 Air.
 *
 * Boots unmodified Android images from the first USB device (then SD) that
 * holds uEnv.txt, boot.img or recovery.img, else from the eMMC partitions
 * (see chainload_load_emmc):
 *   boot.img / recovery.img  Android boot image v0-v2 (kernel, ramdisk,
 *                            cmdline; v2 also the DTB)
 *   dtb.img                  DTB (plain or gzip); else the DTB of the image
 *   dtbo.img                 Android DTBO table, entry chainload_dtbo_idx
 *                            applied
 *   uEnv.txt                 optional: name=value overrides
 *                            (chainload_image, chainload_extra_args, ...);
 *                            if it sets uenvcmd, that runs instead (custom
 *                            boot, devtype/devnum set)
 *   chainload/<name>.txt     fixups, for each name in chainload_fixups:
 *                            imported (env import -t) and "run fix_<name>"
 *                            right before bootm; the DTB is at fdt_addr_r,
 *                            the image name in chainload_img. Board tweaks
 *                            live there, not here.
 *
 * The memory size comes from BL2 (AO_SEC_GP_CFG0): bootm sets /memory reg
 * and ft_system_setup() clamps linux,usable-memory to it, so a DTB made for
 * 4 GiB boots on a 2 GiB box.
 *
 * The environment lives only in RAM (no ENV_IS_IN_*), nothing is written
 * to the eMMC.
 *
 * Installed copy: the rsv partition at +1 MiB; the stock bootcmd loads it to
 * 0x1000000 and jumps there when no USB stick boots.
 */

/* boot.img or recovery.img; the other one is the fallback */
chainload_image=boot.img
chainload_dtb=dtb.img
chainload_dtbo=dtbo.img
chainload_dtbo_idx=0
chainload_fixdir=chainload
chainload_fixups=
chainload_extra_args=

/*
 * eMMC partitions without a USB/SD image: chainload_part (boot or recovery) and
 * dtbo. Mainline U-Boot cannot read the Amlogic partition table (MPT), so
 * the LBAs are fixed; they are the same in the stock A95X table. The eMMC is
 * the mmc device with "MPT" at chainload_mpt_lba.
 */
chainload_part=boot
chainload_mpt_lba=0x12000
chainload_boot_lba=0x2ae000
chainload_boot_blks=0x8000
chainload_recovery_lba=0x27a000
chainload_recovery_blks=0xc000
chainload_dtbo_lba=0x292000
chainload_dtbo_blks=0x4000
chainload_misc_lba=0x28a000

chainload_txt_addr=0x1b000000
/*
 * 2 MiB aligned: arm64 Image with text_offset 0 (5.15) is moved to the 2 MiB
 * boundary below the load address; 0x08080000 would put it over the DTB.
 */
chainload_kernel_addr=0x08200000
chainload_ovl_addr=0x1c000000
chainload_tmp_addr=0x1d000000
chainload_dtbo_addr=0x1e000000
chainload_img_addr=0x20000000

/*
 * Vendor storeargs/initargs (kvim3l 5.15; sm1_a95xf3air_v1 for hdmitx,
 * otg_device and the oem.key1 fallback), minus logo=...,loaded: the stock
 * preboot (init_display) leaves its logo on the OSD, but the video build
 * reprograms the VPU, so vout=...,disable makes the kernel set the HDMI mode
 * itself either way. hdmitx= with an empty cecconfig, as the vendor U-Boot
 * passes it. bootm appends the image header cmdline after these; init keeps
 * the first value of each androidboot.* property.
 *
 * No kernel console on the UART (console=null, as on the other Amlogic boards
 * here): printing to it at 115200 baud blocks for as long as the kernel
 * logs, which stalled audio, display and video decoding for about a second
 * every time a decoder started. dmesg and pstore keep the log.
 */
chainload_args=init=/init console=null printk.devkmsg=on
	ramoops.pstore_en=1 ramoops.record_size=0x8000 ramoops.console_size=0x4000
	otg_device=1 reboot_mode_android=normal
	outputmode=1080p60hz vout=1080p60hz,disable hdmimode=1080p60hz
	hdmitx=,444,8bit
	nativeui=disable frac_rate_policy=1 hdmi_read_edid=1 cvbsmode=576cvbs
	osd_reverse=0 video_reverse=0 irq_check_en=0 jtag=disable
	androidboot.hardware=amlogic androidboot.verifiedbootstate=orange
	androidboot.selinux=enforcing androidboot.firstboot=1
	androidboot.bootloader=U-Boot-mainline
	androidboot.serialno=1234567899
	androidboot.oem.key1=ATV00100020
	androidboot.init_fatal_reboot_target=recovery

/* Sets devtype/devnum to the first device holding one of the boot files. */
chainload_find=
	setenv devtype;
	usb start;
	for d in 0 1 2 3; do
		for f in uEnv.txt boot.img recovery.img; do
			if test -z "${devtype}" && test -e usb ${d} ${f}; then
				setenv devtype usb; setenv devnum ${d};
			fi;
		done;
	done;
	/* No mmc aliases: SDIO, SD and eMMC are mmc 0-2 in DT order. */
	for d in 0 1 2; do
		for f in uEnv.txt boot.img recovery.img; do
			if test -z "${devtype}" && test -e mmc ${d} ${f}; then
				setenv devtype mmc; setenv devnum ${d};
			fi;
		done;
	done

/* DTB to fdt_addr_r: dtb.img (plain or gzip), else the one in the image. */
chainload_load_fdt=
	setenv chainload_fdt_ok;
	if test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${chainload_tmp_addr} ${chainload_dtb}; then
		setexpr.w chainload_magic *${chainload_tmp_addr};
		if test "${chainload_magic}" = "8b1f"; then
			unzip ${chainload_tmp_addr} ${fdt_addr_r} && setenv chainload_fdt_ok 1;
		else
			cp.b ${chainload_tmp_addr} ${fdt_addr_r} ${filesize} &&
			setenv chainload_fdt_ok 1;
		fi;
		if test -n "${chainload_fdt_ok}" && fdt addr ${fdt_addr_r}; then
			echo "chainload: DTB from ${chainload_dtb}";
		else
			echo "chainload: ${chainload_dtb} is not a DTB (Amlogic multi-DTB?)";
			setenv chainload_fdt_ok;
		fi;
	fi;
	if test -z "${chainload_fdt_ok}" &&
	   abootimg get dtb --index=0 chainload_src chainload_size; then
		cp.b ${chainload_src} ${fdt_addr_r} ${chainload_size} &&
		fdt addr ${fdt_addr_r} && setenv chainload_fdt_ok 1 &&
		echo "chainload: DTB from ${chainload_img}";
	fi;
	if test -n "${chainload_fdt_ok}"; then
		fdt addr ${fdt_addr_r} && fdt resize 16384;
	fi

/* DTBO table at chainload_dtbo_addr: entry chainload_dtbo_idx onto the DTB. */
chainload_apply_dtbo=
	if adtimg addr ${chainload_dtbo_addr} &&
	   adtimg get dt --index=${chainload_dtbo_idx} chainload_src chainload_size &&
	   cp.b ${chainload_src} ${chainload_ovl_addr} ${chainload_size} &&
	   fdt addr ${fdt_addr_r} && fdt apply ${chainload_ovl_addr}; then
		echo "chainload: applied ${chainload_dtbo_src} entry ${chainload_dtbo_idx}";
	else
		echo "chainload: ${chainload_dtbo_src} not applied, reloading the DTB";
		run chainload_load_fdt;
	fi

/* dtbo.img from the device, else the eMMC dtbo partition when booting it. */
chainload_load_dtbo=
	setenv chainload_dtbo_src;
	if test -n "${chainload_dtbo}" && test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${chainload_dtbo_addr} ${chainload_dtbo}; then
		setenv chainload_dtbo_src ${chainload_dtbo};
	elif test -n "${chainload_dtbo}" && test "${chainload_img}" = "${chainload_part}" &&
	     mmc dev ${chainload_emmc} &&
	     mmc read ${chainload_dtbo_addr} ${chainload_dtbo_lba} ${chainload_dtbo_blks}; then
		setenv chainload_dtbo_src "eMMC dtbo";
	fi;
	if test -n "${chainload_dtbo_src}"; then
		run chainload_apply_dtbo;
	fi

/* Imports and runs each fixup file; a missing file is skipped. */
chainload_run_fixups=
	for f in ${chainload_fixups}; do
		if load ${devtype} ${devnum} ${chainload_txt_addr} ${chainload_fixdir}/${f}.txt; then
			echo "chainload: fixup ${chainload_fixdir}/${f}.txt";
			env import -t -r ${chainload_txt_addr} ${filesize};
			run fix_${f};
		else
			echo "chainload: no ${chainload_fixdir}/${f}.txt, skipped";
		fi;
	done

/* Sets chainload_emmc to the mmc device with the Amlogic MPT. */
chainload_find_emmc=
	setenv chainload_emmc;
	for d in 0 1 2; do
		if test -z "${chainload_emmc}" && mmc dev ${d} &&
		   mmc read ${chainload_tmp_addr} ${chainload_mpt_lba} 1; then
			setexpr.l chainload_magic *${chainload_tmp_addr};
			if test "${chainload_magic}" = "54504d"; then
				setenv chainload_emmc ${d};
			fi;
		fi;
	done;
	if test -n "${chainload_emmc}"; then
		echo "chainload: eMMC is mmc ${chainload_emmc}";
	fi

/* Image chainload_part (boot or recovery) from the eMMC to chainload_img_addr. */
chainload_load_emmc=
	if test "${chainload_part}" = recovery; then
		setenv chainload_lba ${chainload_recovery_lba};
		setenv chainload_blks ${chainload_recovery_blks};
	else
		setenv chainload_part boot;
		setenv chainload_lba ${chainload_boot_lba};
		setenv chainload_blks ${chainload_boot_blks};
	fi;
	if test -n "${chainload_emmc}" && mmc dev ${chainload_emmc} &&
	   mmc read ${chainload_img_addr} ${chainload_lba} ${chainload_blks}; then
		setenv chainload_img ${chainload_part};
		echo "chainload: ${chainload_part} from eMMC (mmc ${chainload_emmc})";
	fi

/*
 * Recovery when Android asked for it, so it works without a USB/SD image:
 * reboot reason "recovery" (kernel "reboot recovery"/"factory_reset"; the
 * stock U-Boot only reads it) or "boot-recovery" in the misc BCB. uEnv.txt
 * is imported later and can still override chainload_image/chainload_part.
 */
chainload_want_recovery=
	setenv chainload_reason;
	sm reboot_reason chainload_reason;
	setenv chainload_w0; setenv chainload_w1;
	if test -n "${chainload_emmc}" && mmc dev ${chainload_emmc} &&
	   mmc read ${chainload_tmp_addr} ${chainload_misc_lba} 1; then
		setexpr.l chainload_w0 *${chainload_tmp_addr};
		setexpr chainload_w1 ${chainload_tmp_addr} + 4;
		setexpr.l chainload_w1 *${chainload_w1};
	fi;
	if test "${chainload_reason}" = recovery ||
	   test "${chainload_w0}${chainload_w1}" = "746f6f626365722d"; then
		echo "chainload: recovery requested (reason ${chainload_reason})";
		setenv chainload_part recovery;
		setenv chainload_image recovery.img;
	fi

chainload_android=
	setenv kernel_addr_r ${chainload_kernel_addr};
	setenv chainload_img;
	if test -n "${devtype}"; then
		for f in ${chainload_image} boot.img recovery.img; do
			if test -z "${chainload_img}" &&
			   load ${devtype} ${devnum} ${chainload_img_addr} ${f}; then
				setenv chainload_img ${f};
				echo "chainload: ${f} from ${devtype} ${devnum}";
			fi;
		done;
	fi;
	if test -z "${chainload_img}"; then
		run chainload_load_emmc;
	fi;
	if test -z "${chainload_img}"; then
		echo "chainload: no boot.img/recovery.img on USB/SD and no eMMC";
	elif abootimg addr ${chainload_img_addr}; then
		run chainload_load_fdt;
		if test -z "${chainload_fdt_ok}"; then
			echo "chainload: no DTB (dtb.img or in ${chainload_img})";
		else
			run chainload_load_dtbo;
			run chainload_run_fixups;
			setenv bootargs "${chainload_args} ${chainload_extra_args}";
			echo "chainload: bootargs: ${bootargs}";
			bootm ${chainload_img_addr} ${chainload_img_addr} ${fdt_addr_r};
		fi;
	else
		echo "chainload: ${chainload_img} is not an Android boot image";
	fi

chainload_boot=
	run chainload_find;
	run chainload_find_emmc;
	run chainload_want_recovery;
	if test -n "${devtype}" &&
	   load ${devtype} ${devnum} ${chainload_txt_addr} uEnv.txt; then
		echo "chainload: importing uEnv.txt from ${devtype} ${devnum}";
		env import -t -r ${chainload_txt_addr} ${filesize};
	fi;
	if test -n "${uenvcmd}"; then
		echo "chainload: running uenvcmd";
		run uenvcmd;
		echo "chainload: uenvcmd failed, booting the Android image";
	fi;
	run chainload_android
