# MSM8917/MSM8937/MSM8940 use a ChipIdea USB controller with the
# 28nm femto PHY rather than DWC3, use with qcom_defconfig
# CONFIG_USB_XHCI_DWC3 is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_DM_USB_GADGET is not set
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_MSM=y
CONFIG_CI_UDC=y
CONFIG_PHY_QCOM_USB_HS_28NM=y
# Prevents a synchronous abort on the PRNG which is owned by TrustZone
# CONFIG_RNG_MSM is not set
